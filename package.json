{
  "name": "ckw-elements",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "CKW Elements Design System — Monorepo",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter @ckwag/elements-icons run build && tsc -p packages/components && tsc -p apps/storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "release:build": "pnpm --filter @ckwag/elements-tokens run build && pnpm --filter @ckwag/elements-icons run build && pnpm --filter @ckwag/elements run build",
    "release:check": "node scripts/validate-release.mjs",
    "release:pack": "npm pack ./packages/tokens --dry-run --cache ./.npm-pack-cache && npm pack ./packages/icons --dry-run --cache ./.npm-pack-cache && npm pack ./packages/components --dry-run --cache ./.npm-pack-cache",
    "release:validate": "pnpm icons:check && pnpm docs:check && pnpm format:check && pnpm typecheck && pnpm release:build && pnpm release:check && pnpm release:pack",
    "tokens:sync": "pnpm --filter @ckwag/elements-tokens run tokens:sync",
    "icons:generate": "pnpm --filter @ckwag/elements-icons run generate",
    "icons:check": "pnpm --filter @ckwag/elements-icons run check",
    "icons:sync": "node packages/icons/sync-from-figma.mjs",
    "docs:sync": "node scripts/sync-public-docs.mjs",
    "docs:check": "node scripts/sync-public-docs.mjs --check",
    "figma:parse": "figma connect parse --exit-on-unreadable-files",
    "figma:publish": "FIGMA_ACCESS_TOKEN=\"${FIGMA_ACCESS_TOKEN:-$(security find-generic-password -s ckw-figma-code-connect -w 2>/dev/null)}\" figma connect publish --exit-on-unreadable-files",
    "figma:token": "security add-generic-password -U -a \"$USER\" -s ckw-figma-code-connect -w",
    "tokens:check": "node scripts/check-css-vars.mjs",
    "figma:icons": "pnpm --filter @ckwag/elements-icons run build && node scripts/generate-icon-code-connect.mjs"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.11.0",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
