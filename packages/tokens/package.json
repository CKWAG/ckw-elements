{
  "name": "@ckw-elements/tokens",
  "version": "0.0.1",
  "description": "CKW Elements Design Tokens — generated from Figma Variables",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens:transform": "node transform-tokens.mjs",
    "tokens:build": "node build-tokens.mjs",
    "tokens:sync": "node transform-tokens.mjs && node build-tokens.mjs",
    "build": "node build-tokens.mjs"
  },
  "files": [
    "dist/",
    "tokens.json"
  ],
  "main": "./dist/tokens.js",
  "exports": {
    ".": "./dist/tokens.js",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.js": "./dist/tokens.js",
    "./tokens.json": "./tokens.json"
  },
  "devDependencies": {
    "style-dictionary": "^4.3.0"
  }
}
