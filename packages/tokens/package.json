{
  "name": "@ckwag/elements-tokens",
  "version": "0.0.1",
  "description": "CKW Elements Design Tokens — generated from Figma Variables",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/CKWAG/ckw-elements.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://ckwag.github.io/ckw-elements/",
  "bugs": {
    "url": "https://github.com/CKWAG/ckw-elements/issues"
  },
  "keywords": [
    "ckw",
    "design-system",
    "design-tokens",
    "style-dictionary"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tokens:transform": "node transform-tokens.mjs",
    "tokens:build": "node build-tokens.mjs",
    "tokens:sync": "node transform-tokens.mjs && node build-tokens.mjs",
    "build": "node build-tokens.mjs",
    "prepack": "pnpm run build"
  },
  "files": [
    "dist/",
    "README.md",
    "tokens.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.layered.css": "./dist/tokens.layered.css",
    "./tokens.js": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "style-dictionary": "^5.4.4"
  }
}
