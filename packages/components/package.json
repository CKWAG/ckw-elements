{
  "name": "@ckwag/elements",
  "version": "0.0.1",
  "description": "CKW Elements UI Components",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/CKWAG/ckw-elements.git",
    "directory": "packages/components"
  },
  "homepage": "https://ckwag.github.io/ckw-elements/",
  "bugs": {
    "url": "https://github.com/CKWAG/ckw-elements/issues"
  },
  "keywords": [
    "ckw",
    "design-system",
    "react",
    "components"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "pnpm --filter @ckwag/elements-icons run build",
    "build": "node build-components.mjs",
    "prepack": "pnpm run build",
    "lint": "echo 'lint step — will be configured with eslint'"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ckwag/elements-icons": "workspace:*",
    "@ckwag/elements-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
